# Kopiér denne fil, kald kopien .env og udfyld dine egne værdier.
# .env må ALDRIG lægges på GitHub.

# AI-model (Ollama kører gratis på din egen computer)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3.2

# Supabase (valgfrit). Udelades de, gemmes ansøgningerne i mappen udkast/
SUPABASE_URL=https://dit-projekt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=din-secret-key